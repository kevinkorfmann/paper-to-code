initialize() {
    if (!exists("N")) defineConstant("N", 40);
    if (!exists("R")) defineConstant("R", 256);
    if (!exists("M")) defineConstant("M", 0.3);
    if (!exists("RING")) defineConstant("RING", T);
    initializeSLiMModelType("WF");
    initializeMutationRate(0.0);
    initializeMutationType("m1", 0.5, "f", 0.0);
    m1.convertToSubstitution = F;
    initializeGenomicElementType("g1", m1, 1.0);
    initializeGenomicElement(g1, 0, 0);
    initializeRecombinationRate(0.0);
}

1 early() {
    for (r in seqLen(R)) {
        for (i in 0:3)
            sim.addSubpop(4*r+i+1, N);
        pops = sim.subpopulations[4*r + 0:3];
        for (i in 0:3) {
            if (RING)
                pops[i].setMigrationRates(pops[c((i+1)%4, (i+3)%4)], rep(M/2, 2));
            else
                pops[i].setMigrationRates(pops[(0:3) != i], rep(M/3, 3));
        }
    }
}

1 late() {
    for (r in seqLen(R))
        sim.subpopulations[4*r].genomes.addNewDrawnMutation(m1, 0);
}

1:3 late() {
    for (r in seqLen(R)) {
        counts = integer(4);
        for (i in 0:3)
            counts[i] = sum(sim.subpopulations[4*r+i].genomes.countOfMutationsOfType(m1));
        catn(paste(c("DATA", sim.cycle-1, r, counts), sep=","));
    }
    if (sim.cycle == 3)
        sim.simulationFinished();
}
